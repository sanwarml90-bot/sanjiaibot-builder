# Sanji AI builder — environment variables (copy to Railway service variables; never commit real values)
# The builder itself runs on Railway. User bots run on the Northflank
# bot-runner service, which polls the registry file bot-runner/bots.json
# in this repo — no Northflank API token is used.
BOT_TOKEN=
API_ID=
API_HASH=
OWNER_ID=7966027018
GITHUB_OWNER=sanwarml90-bot
GITHUB_PAT=
# FERNET_KEY is REQUIRED: user bot tokens are Fernet-encrypted before being
# written to bot-runner/bots.json, which lives in this PUBLIC repo. Without
# it the builder refuses to register a bot (a plaintext token must never
# land in the public registry). The runner service needs the SAME key.
FERNET_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
# No longer used (the builder never calls the Northflank API; the runner
# service is created once via the Northflank dashboard and polls the
# registry file). Safe to remove.
# NORTHFLANK_API_TOKEN=
# NORTHFLANK_PROJECT_ID=
# NORTHFLANK_TEAM_ID=
# NORTHFLANK_RUNNER_SERVICE=bot-runner
# NORTHFLANK_DEPLOYMENT_PLAN=nf-compute-50
# No longer used for user-bot deploys (Railway's Limited Trial blocks API
# service creation). Kept here only as a reminder — safe to remove.
# RAILWAY_TOKEN=
# RAILWAY_PROJECT_ID=
